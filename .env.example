# DhanHQ Data API Credentials
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# Comma-separated SEGMENT:SECURITY_ID pairs (up to 50 instruments per connection)
# Valid segments: IDX_I, NSE_EQ, NSE_FNO, NSE_CURRENCY, BSE_EQ, MCX_COMM, BSE_CURRENCY, BSE_FNO
DHAN_INSTRUMENTS=NSE_EQ:1333,NSE_EQ:11536,NSE_EQ:1594,NSE_EQ:2885,NSE_EQ:10999,NSE_EQ:317,NSE_EQ:15083,NSE_EQ:1922,NSE_EQ:6705,NSE_EQ:18143,NSE_EQ:383,NSE_EQ:11630,NSE_EQ:4963,NSE_EQ:3045,NSE_EQ:1660,NSE_EQ:21808,NSE_EQ:1363,NSE_EQ:2475,NSE_EQ:10604,NSE_EQ:1174
