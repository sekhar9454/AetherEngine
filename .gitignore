# ==============================================================================
# AetherEngine .gitignore
# ==============================================================================

# Credentials & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.token

# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage Caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Heavy Binary Datasets & Models (Over 200MB / 7.1M rows)
data/
*.parquet
model.txt
experiments/

# IDE & Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
